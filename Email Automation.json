    {
      "parameters": {
        "jsCode": "const email = $input.first().json;\n\n// Parse \"Name <address>\" strings or Gmail's parsed { value: [{ name, address }] } objects\nconst parseAddress = (v) => {\n  if (!v) return { name: '', address: '' };\n  if (typeof v === 'string') {\n    const m = v.match(/^\\s*\"?([^\"<]*)\"?\\s*<([^>]+)>\\s*$/);\n    return m ? { name: m[1].trim(), address: m[2].trim() } : { name: '', address: v.trim() };\n  }\n  const first = v.value && v.value[0];\n  if (first) return { name: first.name || '', address: first.address || '' };\n  return { name: '', address: v.text || '' };\n};\n\nconst from = parseAddress(email.from || email.From);\nconst subject = email.subject || email.Subject || '(No Subject)';\n\nlet body = email.text || email.textPlain || '';\nif (!body && email.html) {\n  body = String(email.html).replace(/<style[\\s\\S]*?<\\/style>/gi, '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n}\nif (!body) body = email.snippet || '';\n\nlet receivedAt = email.date;\nif (!receivedAt && email.internalDate) receivedAt = new Date(Number(email.internalDate)).toISOString();\nif (!receivedAt) receivedAt = new Date().toISOString();\n\nreturn [{\n  json: {\n    message_id: email.id || '',\n    sender_email: from.address,\n    sender_name: from.name,\n    subject: subject,\n    body: body.substring(0, 3000),\n    labels: email.labelIds || [],\n    received_at: receivedAt\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -368,
        -16
      ],
      "id": "6e16a51e-afdc-4ee8-a5bf-5d044fc2456f",
      "name": "Extract Email"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4O-MINI"
        },
        "responses": {
          "values": [
            {
              "content": "# ROLE\nYou are an expert email classifier and customer service analyst. Analyze incoming emails and return ONLY valid JSON.\n\n# OUTPUT SCHEMA\nReturn exactly this structure:\n\n{\n  \"category\": \"question | order | complaint | spam | newsletter | other\",\n  \"priority\": \"high | medium | low\",\n  \"sentiment\": \"positive | neutral | negative | angry\",\n  \"summary\": \"1-2 sentence summary\",\n  \"suggested_reply\": \"Professional reply in the SAME language as the email\",\n  \"handoff_needed\": true | false,\n  \"labels\": [\"tag1\", \"tag2\"],\n  \"is_lead\": true | false,\n  \"lead_data\": {\n    \"phone\": \"or null\",\n    \"company\": \"or null\",\n    \"intent\": \"short description or null\"\n  },\n  \"lead_score\": 0\n}\n\n# CATEGORY RULES\n- \"question\": Asks about a product, service, or info\n- \"order\": Wants to buy, order, or book\n- \"complaint\": Expressing dissatisfaction\n- \"spam\": Promotional, unsolicited, or phishing\n- \"newsletter\": Subscriptions, marketing emails\n- \"other\": Doesn't fit above\n\n# PRIORITY RULES\n- \"high\": Urgent, angry customer, money involved, time-sensitive\n- \"medium\": Standard business inquiry\n- \"low\": Newsletter, spam, FYI\n\n# SENTIMENT RULES\n- \"positive\": Happy, thanking, complimentary\n- \"neutral\": Standard inquiry\n- \"negative\": Mild dissatisfaction\n- \"angry\": Strong complaints, threats, all caps\n\n# HANDOFF RULES (handoff_needed = true if)\n- Sentiment is \"angry\"\n- OR priority is \"high\" AND category is \"complaint\"\n- OR legal, financial, or sensitive topics\n\n# LEAD RULES (is_lead = true if)\n- Sender shows buying intent\n- OR asks for services/pricing\n- OR provides contact info with a request\n\n# LEAD SCORE\n- 80-100: Clear buying intent + contact info\n- 50-79: Interest but missing details\n- 20-49: Vague inquiry\n- 0-19: Not a lead\n\n# LABELS RULES\n- Max 2 labels\n- Short, lowercase\n- Examples: \"pricing\", \"shipping\", \"refund\", \"urgent\"\n\n# CRITICAL OUTPUT RULES\n- Return ONLY the JSON object — nothing else\n- NO markdown fences (no ```json)\n- NO explanation or preamble\n- Reply language MUST match the email's language\n- If a field is not applicable, use null\n- Numbers for lead_score must be integers (not strings)\n\nStart now."
            },
            {
              "content": "=From: {{ $json.sender_name }} <{{ $json.sender_email }}>\nSubject: {{ $json.subject }}\n\nBody:\n{{ $json.body }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
