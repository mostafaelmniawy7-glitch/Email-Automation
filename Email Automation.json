    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nlet aiResponse = '';\nif (input.output && input.output[0] && input.output[0].content && input.output[0].content[0]) {\n  aiResponse = input.output[0].content[0].text;\n} else if (input.message && input.message.content) {\n  aiResponse = input.message.content;\n} else if (input.text) {\n  aiResponse = input.text;\n} else {\n  aiResponse = JSON.stringify(input);\n}\n\nlet parsed;\ntry {\n  const cleaned = aiResponse.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    category: 'other',\n    priority: 'medium',\n    sentiment: 'neutral',\n    summary: '',\n    suggested_reply: '',\n    handoff_needed: false,\n    labels: [],\n    is_lead: false,\n    lead_data: {},\n    lead_score: 0\n  };\n}\n\nconst email = $('Extract Email').first().json;\n\nreturn [{\n  json: {\n    ...email,\n    category: parsed.category || 'other',\n    priority: parsed.priority || 'medium',\n    sentiment: parsed.sentiment || 'neutral',\n    summary: parsed.summary || '',\n    suggested_reply: parsed.suggested_reply || '',\n    handoff: parsed.handoff_needed === true,\n    ai_labels: parsed.labels || [],\n    is_lead: parsed.is_lead === true,\n    lead_phone: parsed.lead_data?.phone || null,\n    lead_company: parsed.lead_data?.company || null,\n    lead_intent: parsed.lead_data?.intent || null,\n    lead_score: parsed.lead_score || 0\n  }\n}];"
      },
