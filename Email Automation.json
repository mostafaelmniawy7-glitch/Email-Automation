    {
      "parameters": {
        "jsCode": "const e = $('Parse Classification').first().json;\n\n// Escape user-controlled text so Telegram's HTML parser never rejects the message\nconst esc = (s) => String(s ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\nconst cut = (s, n) => {\n  const t = String(s ?? '');\n  return t.length > n ? t.slice(0, n) + '...' : t;\n};\n\nconst text = [\n  '📧 <b>إيميل جديد</b>',\n  '',\n  `👤 من: ${esc(e.sender_name)}`,\n  `📩 إيميل: ${esc(e.sender_email)}`,\n  `📌 الموضوع: ${esc(cut(e.subject, 200))}`,\n  '',\n  `🏷️ التصنيف: ${esc(e.category)}`,\n  `⚡ الأولوية: ${esc(e.priority)}`,\n  `😊 المشاعر: ${esc(e.sentiment)}`,\n  '',\n  '📝 <b>ملخص:</b>',\n  esc(cut(e.summary, 800)),\n  '',\n  e.handoff ? '🚨 يحتاج تدخل بشري!' : '✅ تم التعامل أوتوماتيك'\n].join('\\n');\n\nreturn [{ json: { text } }];"
      },
